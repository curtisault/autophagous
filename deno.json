{
  "nodeModulesDir": "auto",
  "imports": {
    "vite": "npm:vite@^8.2.0",
    "vite-plugin-elm": "npm:vite-plugin-elm@^3.0.1",
    "wrangler": "npm:wrangler@^4.122.0"
  },
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "elm-test-rs --deno",
    "print": "typst compile typst/cycle-log.typ public/downloads/cycle-log.pdf",
    "deploy": "deno task build && wrangler pages deploy dist --project-name=autophagous"
  }
}
